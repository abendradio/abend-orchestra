<Project Sdk="Microsoft.NET.Sdk">
  <!-- the test runner: dotnet run, project tests/runner.csproj -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>abend-tests</AssemblyName>
    <StartupObject>Abend.Tests</StartupObject>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/abendc/*.cs" />
    <Compile Include="../src/engine/*.cs" />
  </ItemGroup>
</Project>
