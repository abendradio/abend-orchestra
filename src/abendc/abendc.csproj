<Project Sdk="Microsoft.NET.Sdk">
  <!-- abendc: the command line, for Windows, Mac and Linux -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>abendc</AssemblyName>
    <RootNamespace>Abend</RootNamespace>
    <StartupObject>Abend.Cli</StartupObject>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- runs on .NET 8 or any newer runtime (8 is out of support since November 2026; 10 is the current LTS) -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../engine/*.cs" />
  </ItemGroup>
</Project>
