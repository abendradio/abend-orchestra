    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AbendOrchestra</AssemblyName>
    <RootNamespace>Abend</RootNamespace>
    <StartupObject>Abend.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../abendc/*.cs" />
