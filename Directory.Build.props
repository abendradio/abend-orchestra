<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0162;CS0414;CS0649;CS0169;CA1416;SYSLIB0021</NoWarn>
    <Company>Abend Radio</Company>
    <Copyright>Copyright (c) 2026 Abend Radio (abendradio.com)</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
